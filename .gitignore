# Python bytecode and tool caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.pytype/
.hypothesis/
.coverage
.coverage.*
htmlcov/

# Virtual environments
.venv/
venv/
env/
ENV/
.python-version

# Build and packaging artifacts
build/
dist/
*.egg-info/
.eggs/
pip-wheel-metadata/

# Jupyter temporary and generated files
.ipynb_checkpoints/
*.nbconvert.ipynb
notebooks/outputs/**

# Editors and local agent state
.vscode/
.idea/
.agents/
.codex/
.claude/
*.code-workspace
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Secrets and machine-local configuration
.env
.env.*
!.env.example
*.pem
*.key
credentials*.json
secrets*.json

# Logs, profilers and experiment trackers
*.log
*.out
*.err
slurm-*.out
*.prof
*.trace
wandb/
mlruns/
lightning_logs/
runs/

# Model checkpoints and exported weights
*.pt
*.pth
*.ckpt
*.onnx
*.safetensors

# Generated experiment outputs; retain only the placeholder
outputs/**
!outputs/.gitkeep

# Local datasets, scratch directories and archives
/data/
/datasets/
/scratch/
/tmp/
/temp/
*.zip
*.tar
*.tar.gz
*.tgz
*.7z

# Native crash dumps
core
core.*
